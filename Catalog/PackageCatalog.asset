%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92ea718517cb6a94dad6c71ed720a2b9, type: 3}
  m_Name: PackageCatalog
  m_EditorClassIdentifier: KarlBanan.PackageInstaller.Editor::KarlBanan.PackageInstaller.PackageCatalog
  packages:
  - displayName: KarlBanan Utils
    packageName: com.karlbanan.utils
    gitUrl: https://github.com/ClearKitten/com.karlbanan.utils.git
    icon: {fileID: 0}
    description: General helpers used everywhere. A singleton base class, coroutine
      restart and stop extensions with tweening and easing, and centralized pointer
      access with capture and world conversion.
  - displayName: KarlBanan Attributes
    packageName: com.karlbanan.attributes
    gitUrl: https://github.com/ClearKitten/com.karlbanan.attributes.git
    icon: {fileID: 0}
    description: Inspector attributes for everyday work. Buttons on any method, required
      field validation that blocks play mode, readonly fields, and serializeable
      interface references.
  - displayName: KarlBanan Event Bus
    packageName: com.karlbanan.eventbus
    gitUrl: https://github.com/ClearKitten/com.karlbanan.eventbus.git
    icon: {fileID: 0}
    description: A static event bus using structs as events, with priority based
      subscriptions and a debugger window for inspecting events, subscriptions and
      a live timeline.
  - displayName: KarlBanan Saving
    packageName: com.karlbanan.saving
    gitUrl: https://github.com/ClearKitten/com.karlbanan.saving.git
    icon: {fileID: 0}
    description: A JSON save system with automatic folder resolution, optional AES
      encryption, and slot based saving that collects data from registered objects.
  - displayName: KarlBanan Editor Layout
    packageName: com.karlbanan.editorlayout
    gitUrl: https://github.com/ClearKitten/com.karlbanan.editorlayout.git
    icon: {fileID: 0}
    description: The core layout API for custom editors. Arranges inspector elements
      into rows and columns with configureable sizing, spacing, padding and label
      placement.
  - displayName: KarlBanan Editor Layout Extras
    packageName: com.karlbanan.editorlayout.extras
    gitUrl: https://github.com/ClearKitten/com.karlbanan.editorlayout.extras.git
    icon: {fileID: 0}
    description: Ready to use inspector fields for Editor Layout. Buttons, toggles,
      text, numbers, enums, objects, colors, sliders and vector fields. Requires
      the core Editor Layout package.
  - displayName: KarlBanan Stable IDs
    packageName: com.karlbanan.stableids
    gitUrl: https://github.com/ClearKitten/com.karlbanan.stableids.git
    icon: {fileID: 0}
    description: A ScriptableObject base class with a persistent ID from the asset
      GUID, so save data and references survive renaming and moving. Requires the
      Attributes package.
  - displayName: KarlBanan Node Graph Kit
    packageName: com.karlbanan.nodegraphkit
    gitUrl: https://github.com/ClearKitten/com.karlbanan.nodegraphkit.git
    icon: {fileID: 0}
    description: A framework for building node graph editors. Define your graph and
      node assets and get a full window with typed connections, groups, clipboard,
      minimap and a data panel.
  - displayName: KarlBanan Timers
    packageName: com.karlbanan.timers
    gitUrl: https://github.com/ClearKitten/com.karlbanan.timers.git
    icon: {fileID: 0}
    description: Self ticking timers for gameplay. Countdown, stopwatch and frequency
      timers with scaled or unscaled time, plus an allocation free cooldown struct.
